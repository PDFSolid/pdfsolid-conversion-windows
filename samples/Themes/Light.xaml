<!--
  Neutral palette, light theme. Values are docs/demo_ui/design_spec.md §2.1; the macOS demo
  uses the same numbers, so change both together. ThemeManager swaps this file for Dark.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Paper2Color">#EDEFF3</Color>
    <Color x:Key="InkColor">#161A22</Color>

    <SolidColorBrush x:Key="PaperBrush" Color="#F6F7F9"/>
    <SolidColorBrush x:Key="Paper2Brush" Color="#EDEFF3"/>
    <SolidColorBrush x:Key="SheetBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="#EEF0F4"/>
    <SolidColorBrush x:Key="RuleBrush" Color="#E1E5EB"/>
    <SolidColorBrush x:Key="RuleStrongBrush" Color="#CDD3DC"/>
    <SolidColorBrush x:Key="InkBrush" Color="#161A22"/>
    <SolidColorBrush x:Key="Ink2Brush" Color="#596171"/>
    <SolidColorBrush x:Key="Ink3Brush" Color="#8C94A2"/>
    <SolidColorBrush x:Key="OkBrush" Color="#16803C"/>
    <SolidColorBrush x:Key="BadBrush" Color="#C8322B"/>
    <SolidColorBrush x:Key="SegOnBrush" Color="#FFFFFF"/>
    <!-- ink at 5%, laid over whatever is underneath -->
    <SolidColorBrush x:Key="HoverBrush" Color="#0D161A22"/>
</ResourceDictionary>
